# Copie para .env (não versionado) para apontar para outros WordPress.

# URL pública canônica do novo site (usada em SEO, canonical e sitemap)
VITE_SITE_URL=https://institucional.crf-al.org.br

# WordPress "novo" — eventos e demais recursos (estilo index.php?rest_route=)
VITE_WP_SITE_URL=https://wordpress.crf-al.org.br

# WordPress antigo — fonte exclusiva de notícias e suas mídias (/wp-json/wp/v2)
# Mantido em www (o apex será redirecionado para o subdomínio institucional)
VITE_WP_NEWS_SITE_URL=https://www.crf-al.org.br

# Página do WordPress (novo) que renderiza o feed do Instagram (Smash Balloon).
# Usada pela Pages Function /api/instagram e pelo middleware de dev do Vite.
VITE_INSTAGRAM_FEED_URL=https://wordpress.crf-al.org.br/instagram/

# Perfil do Instagram (botão de fallback do carrossel)
VITE_INSTAGRAM_PROFILE_URL=https://www.instagram.com/crfal/
